{"name": "position-astral-value", "kind": "position", "files": {"main.conf": "x \"\ud83d\ude00\" 8080;\n"}, "root": "main.conf", "target": ["argument", 0, 1, "place"], "expect": {"span": [0, 7, 0, 11], "slice": "8080"}},
{"name": "position-astral-print", "kind": "print", "files": {"main.conf": "x \"\ud83d\ude00\" 8080;\n"}, "root": "main.conf", "target": ["argument", 0, 1, "place"], "expect": {"utf-16": "main.conf:1:8", "code point": "main.conf:1:7"}},
{"name": "print-place", "kind": "print", "files": {"main.conf": "x 1;\ny 8080;\n"}, "root": "main.conf", "target": ["argument", 1, 0, "place"], "expect": "main.conf:2:3"},
{"name": "print-override", "kind": "print", "files": {"main.conf": "x $a;\n"}, "root": "main.conf", "overrides": {"a": "1"}, "target": ["argument", 0, 0, "place"], "expect": "override a"},
{"name": "print-step", "kind": "print", "files": {"main.conf": "set $p 1;\nx $p;\n"}, "root": "main.conf", "target": ["argument", 0, 0, "step", 0], "expect": "variable p at main.conf:2:3"},
{"name": "print-located-diagnostic", "kind": "print", "files": {"main.conf": "x $nope;\n"}, "root": "main.conf", "target": ["diagnostic", 0], "expect": "main.conf:1:3: E5001: {message}"},
{"name": "print-syntax-diagnostic", "kind": "print", "files": {"main.conf": "x ]\n"}, "root": "main.conf", "target": ["syntax diagnostic", "main.conf", 0], "expect": "1:3: E2004: {message}"},
{"name": "format-lone-cr", "kind": "format", "files": {"main.conf": "x 1; # a\rb\n"}, "root": "main.conf", "target": ["diagnostic", 0], "expect": ["main.conf:1:9: E1003: {message}", "x 1; # a\rb", "        ^"]},
{"name": "format-via", "kind": "format", "files": {"main.conf": "snippet s {\n    y $q;\n}\nuse s;\n"}, "root": "main.conf", "target": ["diagnostic", 0], "expect": ["main.conf:2:7: E5001: {message}", "    y $q;", "      ^^", "  via use s at main.conf:4:1"]},
{"name": "format-lone-cr-at-end", "kind": "format", "files": {"main.conf": "x 1;\r"}, "root": "main.conf", "target": ["diagnostic", 0], "expect": ["main.conf:1:5: E1003: {message}", "x 1;\r", "    ^"]}
