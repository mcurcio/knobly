[["ok"],[["main.conf","# rasl config split in two files: sink.conf is included at two places, each with its own variables.\n# `$leds_host` has a default here; a program may hand in its own value, which wins (L3).\n\n@set $pixels 2400;\n@set $leds_host \"10.0.60.30\";\n\ngraph {\n    node Waveform hue_ramp {\n        shape sine;\n        frequency_hz 0.01;\n        output_channels 150;\n        fps 30;\n    }\n\n    node Color crossfade_rgb rgb {\n        connect hue_ramp;\n    }\n\n    @include \"sink.conf\" {\n        @set $name leds;\n        @set $host $leds_host;\n    }\n\n    @include \"sink.conf\" {\n        @set $name porch;\n        @set $host \"10.0.60.31\";\n    }\n}\n"]],[],{"directives":[["graph",true,"main.conf:6:0",[]],["graph > node",true,"main.conf:7:4",[["Waveform","main.conf:7:9","main.conf:7:9",[]],["hue_ramp","main.conf:7:18","main.conf:7:18",[]]]],["graph > node > shape",false,"main.conf:8:8",[["sine","main.conf:8:14","main.conf:8:14",[]]]],["graph > node > frequency_hz",false,"main.conf:9:8",[["0.01","main.conf:9:21","main.conf:9:21",[]]]],["graph > node > output_channels",false,"main.conf:10:8",[["150","main.conf:10:24","main.conf:10:24",[]]]],["graph > node > fps",false,"main.conf:11:8",[["30","main.conf:11:12","main.conf:11:12",[]]]],["graph > node #1",true,"main.conf:14:4",[["Color","main.conf:14:9","main.conf:14:9",[]],["crossfade_rgb","main.conf:14:15","main.conf:14:15",[]],["rgb","main.conf:14:29","main.conf:14:29",[]]]],["graph > node #1 > connect",false,"main.conf:15:8",[["hue_ramp","main.conf:15:16","main.conf:15:16",[]]]],["graph > node #2",true,"sink.conf:1:0 < extension include main.conf:18:4",[["DdpSink","sink.conf:1:5 < extension include main.conf:18:4","sink.conf:1:5",[]],["leds","main.conf:19:19 < variable name sink.conf:1:13 < extension include main.conf:18:4","main.conf:19:19",[["sink.conf:1:13 < extension include main.conf:18:4","main.conf:19:13"]]]]],["graph > node #2 > target",false,"sink.conf:2:4 < extension include main.