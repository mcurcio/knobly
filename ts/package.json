{
  "name": "villanelle",
  "version": "0.0.0-development",
  "description": "A configuration language defined by one formal grammar, with a lossless syntax tree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcurcio/villanelle.git",
    "directory": "ts"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./syntax": {
      "types": "./dist/syntax/index.d.ts",
      "import": "./dist/syntax/index.js"
    },
    "./written": {
      "types": "./dist/written/index.d.ts",
      "import": "./dist/written/index.js"
    },
    "./rendered": {
      "types": "./dist/rendered/index.d.ts",
      "import": "./dist/rendered/index.js"
    },
    "./include": {
      "types": "./dist/include.d.ts",
      "import": "./dist/include.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "gen": "bash ../tools/gen.sh ts",
    "build": "bash ../tools/gen.sh ts && tsc -p tsconfig.build.json",
    "test": "bash ../tools/gen.sh ts && vitest run",
    "typecheck": "bash ../tools/gen.sh ts && tsc --noEmit && tsc -p conformance && tsc -p test",
    "lint": "bash ../tools/gen.sh ts && eslint .",
    "conformance": "python3 ../conformance/driver/run.py -- node conformance/adapter.ts"
  },
  "dependencies": {
    "antlr4": "4.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
