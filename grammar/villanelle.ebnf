/* @rasl/config language, grammar draft 2 (round 11: variables).
   Notation: W3C EBNF (XML 1.0 section 6) in the REx layout: syntax rules,
   then the TOKENS marker, then the regular token definitions.
   Tokenization: at each position the longest match among the token kinds
   wins; kinds are pairwise disjoint, so a tie cannot happen.
   Whitespace is explicit: there is no implicit whitespace anywhere.
   Annotations of the form  cst: kind  name the spec concept a rule builds. */

/* ---------------- syntax ---------------- */

Document     ::= Bom? Statements EOF                       /* cst: document */
Statements   ::= Filler* ( Directive Filler* )* LastDirective?
Filler       ::= Space | Comment | Newline | ';'
Directive    ::= Header ( Separator | Block )               /* cst: directive */
LastDirective
             ::= Header                                     /* cst: directive */
Header       ::= Word Rest
Rest         ::= ( Gap ( Value Rest )? )?
Gap          ::= ( Space | Comment )+
Separator    ::= ';' | Newline
Block        ::= '{' Statements '}'                         /* cst: block */
Value        ::= Word | String | Variable | SlicedWord | List
SlicedWord   ::= Word '[' Bounds ']'                        /* cst: slice */
Bounds       ::= Bound ':' Bound? | ':' Bound | Bound
Bound        ::= Word | Variable
List         ::= '[' ListGap? Items? ']'                     /* cst: list */
Items        ::= Value ListGap? ( ',' ListGap? Items? )?
ListGap      ::= ( Space | Comment | Newline )+

<?TOKENS?>

/* ---------------- tokens ---------------- */
/* tokens: Bom Space Newline Comment Variable Word String '{' '}' '[' ']' ';' ',' ':' UnterminatedString LoneDollar BadChar */

EOF          ::= $
Bom          ::= #xFEFF
Space        ::= [#x20#x9]+
Newline      ::= #xA | #xD #xA
Comment      ::= '#' Char*
Variable     ::= '$' VariableChar+                     /* round 11 L1: nginx's name rule */
Word         ::= NameStart NameChar* | NumberStart NumberChar*
String       ::= '"' ( ( Char - ( '"' | '\' ) ) | '\' Char )* '"'
               | "'" ( ( Char - ( "'" | '\' ) ) | '\' Char )* "'"

/* error tokens: never used by the syntax, so any input holding one is invalid */
UnterminatedString
             ::= '"' ( ( Char - ( '"' | '\' ) ) | '\' Char )* '\'?
               | "'" ( ( Char - ( "'" | '\' ) ) | '\' Char )* '\'?
LoneDollar   ::= '$'                                   /* a '$' with no name after it */
BadChar      ::= AnyChar - TokenStart

/* ---------------- value rules ----------------
   Applied to the whole text of one token after parsing. They never change
   the tokens or the tree; a failure is a located diagnostic. */
/* values: NumberText IntegerText BooleanText EscapeText */

NumberText   ::= '-'? Digits Fraction? Exponent?     /* JSON number, RFC 8259 section 6 */
IntegerText  ::= '-'? Digits                         /* slice bound */
BooleanText  ::= 'true' | 'false'
EscapeText   ::= '\' ( '"' | "'" | '\' | 'n' | 't' | 'r' )
Digits       ::= '0' | [1-9] [0-9]*
Fraction     ::= '.' [0-9]+
Exponent     ::= [eE] [-+]? [0-9]+

/* ---------------- character sets ---------------- */

AnyChar      ::= [#x1-#x10FFFF]      /* U+0000 is also BadChar; REx reserves it as end of input */
Char         ::= #x9 | [#x20-#x7E] | [#x80-#xD7FF] | [#xE000-#x10FFFF]
NameStart    ::= [A-Za-z_./@*?]
NameChar     ::= [A-Za-z0-9_./@#+:*?] | '-'
NumberStart  ::= [0-9] | '-'
NumberChar   ::= [A-Za-z0-9_./@#+*?] | '-'
VariableChar ::= [A-Za-z0-9_]
TokenStart   ::= [#x9#xA#x20"#$',./0-9:;@A-Z_a-z{}*?] | '[' | ']' | '-' | #xFEFF
