/* villanelle language, grammar draft 2 (round 11: variables; milestone 4: ';' ends every statement, a line
   break is whitespace, directive names cannot start with a digit or '-', and the entry rules).
   Kept in step with grammar/Villanelle.g4 by hand; the .g4 is the specification.
   Notation: W3C EBNF (XML 1.0 section 6) in the REx layout: syntax rules,
   then the TOKENS marker, then the regular token definitions.
   Tokenization: at each position the longest match among the token kinds
   wins; kinds are pairwise disjoint, so a tie cannot happen.
   Whitespace is explicit: there is no implicit whitespace anywhere.
   Annotations of the form  cst: kind  name the spec concept a rule builds. */

/* ---------------- syntax ---------------- */

Document     ::= Bom? Statements EOF                       /* cst: document */
Statements   ::= Filler* ( Directive Filler* )*
Filler       ::= Space | Comment | Newline | ';'
Directive    ::= Header ( ';' | Block )                     /* cst: directive */
Header       ::= Word Rest
Rest         ::= ( Gap Value )* Gap?
Gap          ::= ( Space | Newline | Comment Newline )+     /* a comment runs to the end of its line */
Block        ::= '{' Statements '}'                         /* cst: block */
Value        ::= Word | Integer | DigitWord | String | Variable | SlicedWord | List
SlicedWord   ::= Word '[' Bounds ']'                        /* cst: slice */
Bounds       ::= Bound ':' Bound? | ':' Bound | Bound
Bound        ::= Integer | Variable
List         ::= '[' Gap? Items? ']'                        /* cst: list */
Items        ::= Value Gap? ( ',' Gap? Value Gap? )* ( ',' Gap? )?

/* entry rules (spec 2.8): a text a program hands to an edit or an override, parsed on its own */
ValuesText   ::= Gap? ( Value ( Gap Value )* Gap? )? EOF
ItemsText    ::= Gap? ( Value Gap? ( ',' Gap? Value Gap? )* )? EOF
BoundText    ::= Bound EOF
NameText     ::= Word EOF

<?TOKENS?>

/* ---------------- tokens ---------------- */
/* tokens: Bom Space Newline Comment Variable Word Integer DigitWord String '{' '}' '[' ']' ';' ',' ':' UnterminatedString BadEscape LoneDollar BadChar */

EOF          ::= $
Bom          ::= #xFEFF
Space        ::= [#x20#x9]+
Newline      ::= #xA | #xD #xA
Comment      ::= '#' Char*
Variable     ::= '$' VariableChar+                     /* round 11 L1: nginx's name rule */
Word         ::= NameStart NameChar*                   /* the only word a directive name can be */
Integer      ::= IntegerText                           /* the only literal slice or index bound */
DigitWord    ::= ( NumberStart NumberChar* ) - Integer /* every other word that starts with a digit or '-' */
String       ::= '"' ( ( Char - ( '"' | '\' ) ) | EscapeText )* '"'
               | "'" ( ( Char - ( "'" | '\' ) ) | EscapeText )* "'"

/* error tokens: never used by the syntax, so any input holding one is invalid */
UnterminatedString
             ::= '"' ( ( Char - ( '"' | '\' ) ) | '\' Char )* '\'?
               | "'" ( ( Char - ( "'" | '\' ) ) | '\' Char )* '\'?
BadEscape    ::= '"' ( ( Char - ( '"' | '\' ) ) | '\' Char )* '\' ( Char - EscapeChar )
                   ( ( Char - ( '"' | '\' ) ) | '\' Char )* '"'
               | "'" ( ( Char - ( "'" | '\' ) ) | '\' Char )* '\' ( Char - EscapeChar )
                   ( ( Char - ( "'" | '\' ) ) | '\' Char )* "'"   /* a closed string with a bad escape */
LoneDollar   ::= '$'                                   /* a '$' with no name after it */
BadChar      ::= AnyChar - TokenStart

/* ---------------- value rules ----------------
   Applied by the readers (spec 2.9) to the whole text of one word token after parsing. They never change
   the tokens or the tree; a failure is a reader's diagnostic error. IntegerText and EscapeText are also
   token rules since milestone 4 (Integer, String, BadEscape). */
/* values: NumberText IntegerText BooleanText EscapeText */

NumberText   ::= '-'? Digits Fraction? Exponent?     /* JSON number, RFC 8259 section 6 */
IntegerText  ::= '-'? Digits                         /* slice bound */
BooleanText  ::= 'true' | 'false'
EscapeText   ::= '\' EscapeChar
EscapeChar   ::= '"' | "'" | '\' | 'n' | 't' | 'r'
Digits       ::= '0' | [1-9] [0-9]*
Fraction     ::= '.' [0-9]+
Exponent     ::= [eE] [-+]? [0-9]+

/* ---------------- character sets ---------------- */

AnyChar      ::= [#x1-#x10FFFF]      /* U+0000 is also BadChar; REx reserves it as end of input */
Char         ::= #x9 | [#x20-#x7E] | [#x80-#xD7FF] | [#xE000-#x10FFFF]
NameStart    ::= [A-Za-z_./@*?]
NameChar     ::= [A-Za-z0-9_./@#+:*?] | '-'
NumberStart  ::= [0-9] | '-'
NumberChar   ::= [A-Za-z0-9_./@#+*?] | '-'
VariableChar ::= [A-Za-z0-9_]
TokenStart   ::= [#x9#xA#x20"#$',./0-9:;@A-Z_a-z{}*?] | '[' | ']' | '-' | #xFEFF
