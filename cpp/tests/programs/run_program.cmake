# Every programs_<name> test (frozen-m3.md 4): run one design program once per run folder of its expected folder, each
# time in a fresh copy of its fixture, and compare what it printed and its exit status with that run's files.
#   cmake -DPROGRAM=<program> -DFIXTURE=<tests/programs/name> -DEXPECTED=<tests/programs/name_expected>
#         -DWORK=<scratch directory> -P run_program.cmake
# A run folder holds:
#   args     the program's arguments, one per line (absent: none)
#   stdout   what it must print to standard output
#   stderr   what it must print to standard error
#   status   its exit status
#   files/   (optional) files the work folder must hold afterwards, byte for byte (the editor's saved files)
file(GLOB runs LIST_DIRECTORIES true RELATIVE "${EXPECTED}" "${EXPECTED}/*")
list(SORT runs)
set(failures "")
set(count 0)
foreach(run IN LISTS runs)
  set(expected "${EXPECTED}/${run}")
  if(NOT IS_DIRECTORY "${expected}")
    continue()
  endif()
  math(EXPR count "${count} + 1")
  set(work "${WORK}/${run}")
  file(REMOVE_RECURSE "${work}")
  file(COPY "${FIXTURE}/" DESTINATION "${work}")
  set(arguments "")
  if(EXISTS "${expected}/args")
    file(STRINGS "${expected}/args" arguments)
  endif()
  execute_process(COMMAND "${PROGRAM}" ${arguments} WORKING_DIRECTORY "${work}" RESULT_VARIABLE status
                  OUTPUT_VARIABLE out ERROR_VARIABLE err)
  message(STATUS "${run}: exit ${status}\n--- stdout\n${out}--- stderr\n${err}")
  file(READ "${expected}/status" want_status)
  string(STRIP "${want_status}" want_status)
  if(NOT status STREQUAL want_status)
    string(APPEND failures "${run}: exit status ${status}, expected ${want_status}\n")
  endif()
  foreach(stream IN ITEMS stdout stderr)
    file(READ "${expected}/${stream}" want)
    if(stream STREQUAL "stdout")
      set(got "${out}")
    else()
      set(got "${err}")
    endif()
    if(NOT got STREQUAL want)
      string(APPEND failures "${run}: ${stream} was\n${got}--- expected\n${want}")
    endif()
  endforeach()
  if(IS_DIRECTORY "${expected}/files")
    file(GLOB_RECURSE kept RELATIVE "${expected}/files" "${expected}/files/*")
    foreach(name IN LISTS kept)
      if(NOT EXISTS "${work}/${name}")
        string(APPEND failures "${run}: ${name} is missing after the run\n")
        continue()
      endif()
      file(READ "${work}/${name}" got)
      file(READ "${expected}/files/${name}" want)
      if(NOT got STREQUAL want)
        string(APPEND failures "${run}: ${name} after the run was\n${got}--- expected\n${want}")
      endif()
    endforeach()
  endif()
endforeach()
if(count EQUAL 0)
  message(FATAL_ERROR "no run folders in ${EXPECTED}")
endif()
if(NOT failures STREQUAL "")
  message(FATAL_ERROR "${failures}")
endif()
