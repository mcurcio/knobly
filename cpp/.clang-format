# The one C++ style: clang-format, pinned in tools/api/emit_cpp.py (CLANG_FORMAT), formats the generated headers
# (spec/codegen.md section 4) and is the lint for the hand-written ones.
BasedOnStyle: Google
ColumnLimit: 120
IndentWidth: 4
