grammar ConfAmb;
document : stmts EOF ;
stmts    : sep* stmt* header? ;
stmt     : header sep* | header block sep* ;
header   : WORD value* ;
block    : '{' stmts '}' ;
sep      : ';' | NEWLINE ;
value    : WORD | STRING | list ;
list     : '[' NEWLINE* items? ']' ;
items    : value NEWLINE* (',' NEWLINE* value NEWLINE*)* (',' NEWLINE*)? ;
NEWLINE  : '\r'? '\n' ;
WS       : [ \t]+ -> channel(HIDDEN) ;
LINE_COMMENT  : ('#' | '//') ~[\r\n]* -> channel(HIDDEN) ;
BLOCK_COMMENT : '/*' .*? '*/' -> channel(HIDDEN) ;
STRING   : '"' (~["\\\r\n] | '\\' [\\nrt"'])* '"' | '\'' (~['\\\r\n] | '\\' [\\nrt"'])* '\'' ;
WORD     : (HEAD | '/' (NEXT TAIL*)?) TAIL* SLICE? ;
fragment TAIL : ~[ \t\r\n;{}[\],"'\u0000-\u001f] ;
fragment HEAD : ~[ \t\r\n;{}[\],"'\u0000-\u001f#:/] ;
fragment NEXT : ~[ \t\r\n;{}[\],"'\u0000-\u001f/*] ;
fragment SLICE : '[' ([0-9]+ ':' [0-9]* | ':' [0-9]+) ']' ;
